  "narrative": {
    "northStar": "The Night Path Studio",
    "overview": "MathWise\u2019s interface is a calm, dark studio for parents choosing maths support \u2014 trustworthy, unrushed, and clear. Near-black canvases with a soft night atmosphere hold soft, lifted panels; Signal Blue is the guiding accent, not wallpaper. The home experience is literally a path: a glowing vertical line connects hero \u2192 team \u2192 about \u2192 CTA, so the page feels like a quiet journey rather than a brochure stack.\n\nDensity stays measured. Large flow gaps (400px desktop) and generous card padding slow the scroll; type is system UI for familiarity, with heavy display weights reserved for parent-facing headlines. Motion is purposeful (path draw, gentle card fade-ins, soft hover lift) \u2014 never frantic.",
    "keyCharacteristics": [
      "Near-black canvas with soft night atmosphere (low Signal Blue radials + Night Slate depth), sparse constellation dots in side gutters, and ink panels; Signal Blue is the sole primary accent",
      "Soft pill CTAs and eyebrow chips; inviting, not corporate-sharp",
      "Lifted glow depth on hero shells and key cards",
      "Signature animated path as the home-page narrative device",
      "Logo wordmark uses a white\u2192Signal Blue gradient; preserve logo assets"
    ],
    "rules": [
      {
        "name": "The Signal Rarity Rule",
        "body": "Signal Blue should remain a minority of any screen \u2014 accents, links, path, and CTAs \u2014 never full-bleed backgrounds or large text blocks.",
        "section": "colors"
      },
      {
        "name": "The Dark Continuity Rule",
        "body": "All marketing surfaces (including Enrol) belong on the void/panel system \u2014 Panel Ink form card, Panel Soft fields, Signal Blue focus and gradient submit.",
        "section": "colors"
      },
      {
        "name": "The Weight Ladder Rule",
        "body": "Reserve 900 for hero display; section titles stay 700\u2013800; body never competes with Signal Blue emphasis spans.",
        "section": "typography"
      },
      {
        "name": "The Path Spine Rule",
        "body": "On home, major sections should remain path-anchorable (origin \u2192 anchors \u2192 end). Do not collapse the long vertical rhythm into a tight card stack without a replacement narrative device.",
        "section": "layout"
      },
      {
        "name": "The Resting Quiet Rule",
        "body": "At rest, most panels stay modest; reserve the double-shadow + blue bloom for hero and final CTA shells.",
        "section": "elevation"
      },
      {
        "name": "The Soft Invite Rule",
        "body": "Prefer pill CTAs and 16\u201324px card radii over sharp rectangles or hairline \u201ceditorial\u201d corners.",
        "section": "shapes"
      }
    ],
    "dos": [
      "Do keep Void Black + Panel Ink + Signal Blue as the default triad.",
      "Do use pill CTAs with soft hover lift/scale for conversion actions.",
      "Do preserve logo assets and the white\u2192Signal Blue gradient wordmark treatment.",
      "Do keep checklist ticks Success Mint and review stars Star Amber \u2014 not Signal Blue.",
      "Do keep Enrol (and any new forms) on the dark panel language."
    ],
    "donts": [
      "Don't flood screens with Signal Blue backgrounds; rarity is the accent\u2019s job.",
      "Don't introduce a second primary accent family (purple, teal branding, warm cream education tropes).",
      "Don't reintroduce a light Calibri enrol card \u2014 stay on Panel Ink.",
      "Don't replace the home path narrative with a dense dashboard of cards.",
      "Don't invent testimonials, school logos, or result claims as visual decoration."
    ]
  }
}
